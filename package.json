{
  "name": "devtree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "tsc && vite build",
    "build:wasm": "wasm-pack build crates/devtree-core --target web --features wasm && rm -rf src/wasm && cp -r crates/devtree-core/pkg src/wasm",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "test:all": "npm run test:rust && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.11.1",
    "lucide": "^1.27.0",
    "wasm-pack": "^0.15.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
